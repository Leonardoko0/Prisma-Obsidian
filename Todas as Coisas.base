views:
  - type: table
    name: Visualizaçao padrão
  - type: cards
    name: Classes
    groupBy:
      property: file.size
      direction: DESC
    groupOrder: []
    sort:
      - property: file.name
        direction: ASC
    cardSize: 170
    image: note.aliases
    imageFit: contain
    imageAspectRatio: 0.25
